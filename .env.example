# Model: a Hugging Face Hub id or a local folder.
# For Streamlit Cloud / HF Spaces use a Hub id (local files are not deployed).
MODEL_PATH=facebook/bart-large-cnn
# Faster on CPU, slightly lower ROUGE (see the README):
# MODEL_PATH=sshleifer/distilbart-cnn-12-6

# Longer text is split into chunks of at most this many tokens
MAX_INPUT_TOKENS=1024
CHUNK_OVERLAP_TOKENS=64
NUM_BEAMS=4

LOG_LEVEL=INFO

# Only for upload_model_to_hub.py (or run `huggingface-cli login` instead)
# HF_TOKEN=
